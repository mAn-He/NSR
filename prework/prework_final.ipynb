  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def apply_boxcox_transformations(df, target_col='판매수량'):\\n",
    "    if target_col not in df.columns: return df, None, None, None\\n",
    "    y = df[target_col].values\\n",
    "    y_positive = y + 1 if (y <= 0).any() else y\\n",
    "    if (y <= 0).any(): print(f\\"Warning: Added 1 to '{target_col}' for BoxCox.\\")\\n",
    "    boxcox_y, lambda_val = boxcox(y_positive)\\n",
    "    lower_y = np.quantile(y_positive, 0.16); upper_y = np.quantile(y_positive, 0.84)\\n",
    "    term_lower = np.log(lower_y) if abs(lambda_val) < 1e-6 else np.power(lower_y, lambda_val)\\n",
    "    term_upper = np.log(upper_y) if abs(lambda_val) < 1e-6 else np.power(upper_y, lambda_val)\\n",
    "    a_param = 2 / (term_lower - term_upper) if abs(term_lower - term_upper) > 1e-6 else 1.0\\n",
    "    b_param = a_param * term_lower - 1 if abs(term_lower - term_upper) > 1e-6 else 0.0\\n",
    "    df[target_col + '_scaled'] = np.round(a_param * boxcox_y - b_param, 4)\\n",
    "    print(f\\"Applied BoxCox to '{target_col}'. Lambda={lambda_val:.4f}, a={a_param:.4f}, b={b_param:.4f}\\")\\n",
    "    return df, a_param, b_param, lambda_val\\n",
    "\\n",
    "if nsr_df is not None: \\n",
    "    nsr_df, a_bc, b_bc, lambda_bc = apply_boxcox_transformations(nsr_df.copy())\\n",
    "    print(nsr_df[['판매수량', '판매수량_scaled']].head())\\n",
    "else: print(\\"Skipping BoxCox: DataFrame not loaded.\\")"
   ]
